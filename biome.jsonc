{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "off",
        "noBitwiseOperators": "off"
      },
      "style": { "noNonNullAssertion": "off" },
      "a11y": { "noSvgWithoutTitle": "off", "useSemanticElements": "off" },
      "correctness": { "useUniqueElementIds": "off", "noUnusedVariables": "warn" },
      "performance": { "noBarrelFile": "off", "useTopLevelRegex": "off" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "files": {
    "includes": ["**/*.ts", "**/*.tsx", "!node_modules", "!.next", "!*.config.ts"]
  }
}
