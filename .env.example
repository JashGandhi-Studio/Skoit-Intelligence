# ---------------------------------------------------------------------------
# SkOiT — every variable here is optional.
#
# Nothing below is required to run the console. Skills that need a key report
# themselves as unavailable rather than inventing a result, so leaving this file
# untouched produces an honest, partially-covered investigation instead of a
# fabricated complete one. Keys may also be entered in the UI (Settings → Keys),
# where they are stored in ~/.skoit/config.json with owner-only permissions.
# ---------------------------------------------------------------------------

# --- Briefing models (optional: without one, briefings are deterministic) ---
SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-m

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# Any OpenAI-compatible server. Loopback addresses only — the console refuses to
# act as a proxy into other internal networks.
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# COMPATIBLE_MODEL=llama3.1
COMPATIBLE_API_KEY=

# Force a provider when several are configured: sarvam | openai | anthropic |
# google | compatible
# SKOIT_MODEL_PROVIDER=sarvam

# --- Keyed intelligence sources (optional) ---
HIBP_API_KEY=            # haveibeenpwned.com — account-level breach records
SEARCH_API_KEY=          # Brave Search — open-web and news queries
OPENSANCTIONS_API_KEY=   # opensanctions.org — sanctions and PEP screening
VIRUSTOTAL_API_KEY=      # virustotal.com — file hash reputation

# --- Keyed media libraries (optional) ---
# Without these, image, video and audio search still run against the keyless
# sources: Wikimedia Commons, Openverse, NASA, the Internet Archive, and the
# official 30-second catalogue previews for released music.
PEXELS_API_KEY=          # pexels.com — stock photos and video clips
PIXABAY_API_KEY=         # pixabay.com — images, video and B-roll
UNSPLASH_ACCESS_KEY=     # unsplash.com — photography
JAMENDO_CLIENT_ID=       # developer.jamendo.com — free client id; adds its whole
                         # Creative Commons catalogue as full downloadable tracks

# --- Runtime ---
# Where case files and the local key store are written (default ~/.skoit).
# SKOIT_DATA_DIR=/var/lib/skoit
