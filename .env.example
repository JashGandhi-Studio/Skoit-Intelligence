# ---------------------------------------------------------------------------
# INDUS — all keys are optional.
#
# Nothing here is required to run the console. Skills that need a key report
# themselves as unavailable rather than inventing a result, so leaving these
# blank produces an honest, partially-covered investigation instead of a fake
# complete one. Every key can also be entered in the UI (Settings → Keys),
# where it is stored in ~/.indus/config.json with owner-only permissions.
# ---------------------------------------------------------------------------

# --- Briefing models (optional: without one, briefings are deterministic) ---
SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-m
# SARVAM_BASE_URL=https://api.sarvam.ai/v1

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# Local model server (Ollama, LM Studio). Setting the base URL opts it in.
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# COMPATIBLE_MODEL=llama3.1
COMPATIBLE_API_KEY=

# Force a specific briefing provider when several are configured.
# INDUS_MODEL_PROVIDER=sarvam

# --- Keyed intelligence sources (optional) ---
HIBP_API_KEY=                 # haveibeenpwned.com — account-level breach records
SEARCH_API_KEY=               # Brave Search (or Bing-compatible) — web/news queries
# SEARCH_API_ENDPOINT=https://api.search.brave.com/res/v1/web/search
OPENSANCTIONS_API_KEY=        # opensanctions.org — sanctions and PEP screening
VIRUSTOTAL_API_KEY=           # virustotal.com — file hash reputation

# --- Runtime ---
# Where case files and the local key store are written.
# INDUS_DATA_DIR=/var/lib/indus
